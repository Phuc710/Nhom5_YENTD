# =============================================
# Backend Configuration Template
# Copy to .env and fill in real values
# KHONG commit .env nay len git!
# =============================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Shared local LAN source of truth
# All-local: chi sua 1 dong nay, cac URL local con lai de trong de backend tu suy ra.
LOCAL_LAN_IP=192.168.1.7

# ThingsBoard
THINGSBOARD_URL=
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant

# MQTT (ThingsBoard broker)
MQTT_TB_HOST=
MQTT_TB_PORT=1883

# MQTT (Mosquitto broker)
MQTT_HOST=
MQTT_PORT=1888

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
PUBLIC_API_URL=
ENABLE_STREAM_WORKERS=true
STREAM_WORKERS_START_ON_STARTUP=false
STREAM_CAPTURE_MODE=mjpeg
STREAM_SNAPSHOT_INTERVAL_MS=800

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ML Models
DETECTOR_MODEL_PATH=ml/LP_detector_nano_61.pt
OCR_MODEL_PATH=ml/LP_ocr_nano_62.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
ML_PRELOAD_ON_STARTUP=true

# Violation crop tuning
VEHICLE_CROP_PAD_X=2.5
VEHICLE_CROP_PAD_TOP=3.0
VEHICLE_CROP_PAD_BOTTOM=1.5

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# CORS - frontend origins
# Dev local: http://localhost:8080,http://127.0.0.1:8080
# Production: https://app.your-domain.com
CORS_ORIGINS=

# Shared local config sync
# Chinh nhom nay trong backend/.env roi chay:
#   venv\Scripts\python.exe backend\scripts\sync_local_config.py
# de cap nhat frontend/.env va esp32-s3-devkitc-1/platformio.ini
FRONTEND_API_MODE=direct
TB_PROVISIONING_KEY=
TB_PROVISIONING_SECRET=
ESP_WIFI_AP_SSID=ESP32_Config
ESP_WIFI_AP_PASS=12345678
ESP_DEVICE_PREFIX=PCB Cam
ESP_DEVICE_MODEL=PCB S3
# Firmware default only. Backend does not use this to match devices.
ESP_CAMERA_ID=1
ESP_DEVICE_LOCATION=Chua xac dinh
# Firmware static IP only. Backend matches by MAC + ThingsBoard.
ESP_STATIC_IP=192.168.1.8
ESP_STATIC_NETMASK=255.255.255.0
ESP_STATIC_GATEWAY=192.168.1.1
