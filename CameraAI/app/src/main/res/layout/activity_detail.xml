<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bgDarker"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bgDarker"
            app:titleTextColor="@color/colorAccent" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Ảnh toàn cảnh ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📸 Ảnh toàn cảnh" android:textColor="@color/colorAccent"
                android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="6dp"/>
            <ImageView
                android:id="@+id/ivFullImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="@color/cardBg"
                android:adjustViewBounds="true"
                android:layout_marginBottom="16dp" />

            <!-- ── Ảnh xe & biển số side by side ── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🚗 Xe vi phạm" android:textColor="@color/colorAccent"
                        android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <ImageView android:id="@+id/ivVehicle"
                        android:layout_width="match_parent" android:layout_height="120dp"
                        android:scaleType="centerCrop" android:background="@color/cardBg"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔍 Biển số" android:textColor="@color/colorAccent"
                        android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <ImageView android:id="@+id/ivPlate"
                        android:layout_width="match_parent" android:layout_height="120dp"
                        android:scaleType="fitCenter" android:background="@color/cardBg"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── Stop line snapshot ── -->
            <LinearLayout android:id="@+id/groupStopLine"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🛑 Vạch dừng" android:textColor="@color/colorAccent"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <ImageView android:id="@+id/ivStopLine"
                    android:layout_width="match_parent" android:layout_height="160dp"
                    android:scaleType="centerCrop" android:background="@color/cardBg"/>
            </LinearLayout>

            <!-- ── Info Card ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBg" app:cardCornerRadius="12dp"
                app:cardElevation="4dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="THÔNG TIN VI PHẠM" android:textColor="@color/colorAccent"
                        android:textSize="11sp" android:textStyle="bold"
                        android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>

                    <!-- Plate -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Biển số:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvPlate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/colorAccent" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Violation type -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Loại vi phạm:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvViolationType"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/red" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Light state -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Trạng thái đèn:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvLightState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/textPrimary" android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- DateTime -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Ngày giờ:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvDateTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/textPrimary" android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Camera -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Camera:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvCamera"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/textPrimary" android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Địa điểm:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvLocation"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:textColor="@color/textPrimary" android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Fine amount -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="0dp">
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                            android:text="Số tiền phạt:" android:textColor="@color/textSecondary" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvFine"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/amber" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Technical Info Card ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBg" app:cardCornerRadius="12dp"
                app:cardElevation="4dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CHI TIẾT KỸ THUẬT" android:textColor="@color/colorAccent"
                        android:textSize="11sp" android:textStyle="bold"
                        android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Độ chính xác OCR" android:textColor="@color/textSecondary" android:textSize="11sp"/>
                            <TextView android:id="@+id/tvConfidence"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/green" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Track ID" android:textColor="@color/textSecondary" android:textSize="11sp"/>
                            <TextView android:id="@+id/tvTrackId"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" android:textSize="14sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Frames OCR" android:textColor="@color/textSecondary" android:textSize="11sp"/>
                            <TextView android:id="@+id/tvVoteCount"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Vote %" android:textColor="@color/textSecondary" android:textSize="11sp"/>
                            <TextView android:id="@+id/tvVotePercent"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" android:textSize="14sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Proc time" android:textColor="@color/textSecondary" android:textSize="11sp"/>
                            <TextView android:id="@+id/tvProcTime"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" android:textSize="14sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Quality" android:textColor="@color/textSecondary" android:textSize="11sp"/>
                            <TextView android:id="@+id/tvQuality"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary" android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Payment status ── -->
            <TextView
                android:id="@+id/tvPaymentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPaidAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Nộp phạt button -->
            <Button
                android:id="@+id/btnPay"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="💳 NỘP PHẠT NGAY"
                android:textSize="15sp"
                android:textStyle="bold"
                style="@style/ButtonPrimary"
                android:layout_marginBottom="32dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
